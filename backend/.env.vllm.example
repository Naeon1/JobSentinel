# =============================================================================
# vLLM配置示例
# =============================================================================
# 前提：已安装并启动vLLM
# 启动命令：python -m vllm.entrypoints.openai.api_server --model Qwen/Qwen2-7B-Instruct

# 数据库配置
DATABASE_URL=postgresql://postgres:password@localhost:5432/jobsentinel

# LLM配置
LLM_PROVIDER=openai
LLM_API_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed
LLM_MODEL_NAME=Qwen/Qwen2-7B-Instruct
LLM_USE_ANTHROPIC_FORMAT=false

# 搜索API（需要注册SerpAPI获取）
SERPAPI_KEY=your-serpapi-key

# 邮件配置（可选）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO_LIST=["recipient@example.com"]

# 应用配置
APP_NAME=JobSentinel
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:5173"]
