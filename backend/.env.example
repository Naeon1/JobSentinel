# JobSentinel - 环境变量配置模板
# 复制此文件为 .env 并填入实际配置

# =============================================================================
# 数据库配置
# 默认用 SQLite（零配置，开箱即用，数据库文件生成在 backend/jobsentinel.db）
# 如需 PostgreSQL / Supabase，把下面这行换成对应的连接串即可，例如：
# DATABASE_URL=postgresql://postgres:your-password@db.xxxxx.supabase.co:5432/postgres
# =============================================================================
DATABASE_URL=sqlite:///./jobsentinel.db

# =============================================================================
# AI服务配置（支持自定义API地址）
# =============================================================================

# API类型：openai / anthropic / custom
# 如果使用兼容OpenAI接口的服务（如Ollama、vLLM、第三方代理），选择 openai
LLM_PROVIDER=openai

# 自定义API地址（兼容OpenAI格式的服务）
# 示例：
# - Ollama: http://localhost:11434/v1
# - vLLM: http://localhost:8000/v1
# - 第三方代理: https://api.example.com/v1
# - OpenAI官方: https://api.openai.com/v1
# - Anthropic官方: https://api.anthropic.com
LLM_API_BASE_URL=https://api.openai.com/v1

# API密钥
LLM_API_KEY=sk-xxxxxxxxxxxxx

# 模型名称
# 示例：
# - OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# - Ollama: qwen2:7b, llama3:8b, deepseek-coder:7b
# - Claude: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
LLM_MODEL_NAME=gpt-4o

# 是否使用Anthropic格式（仅当LLM_PROVIDER=anthropic时有效）
# 如果使用兼容OpenAI格式的服务，保持为false
LLM_USE_ANTHROPIC_FORMAT=false

# =============================================================================
# 搜索API配置
# =============================================================================
SERPAPI_KEY=xxxxxxxxxxxxx

# =============================================================================
# 邮件配置 (SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO_LIST=["recipient1@example.com", "recipient2@example.com"]

# =============================================================================
# 应用配置
# =============================================================================
APP_NAME=JobSentinel
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# CORS配置（前端域名）
CORS_ORIGINS=["http://localhost:5173", "https://your-frontend.vercel.app"]

# =============================================================================
# 定时任务配置
# =============================================================================
# Cron表达式，默认每天早上9点执行
SCHEDULE_CRON=0 9 * * *

# 是否启用定时任务（默认关闭，请在前端系统设置页启用）
SCHEDULE_ENABLED=false

# =============================================================================
# 搜索配置
# =============================================================================
# 每个搜索任务的结果数量限制
SEARCH_RESULTS_LIMIT=10

# 搜索请求间隔（秒），避免触发反爬
SEARCH_DELAY=2

# 是否使用代理
USE_PROXY=false
PROXY_URL=

# =============================================================================
# 日志配置
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
